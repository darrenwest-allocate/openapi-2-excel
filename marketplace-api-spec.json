        "basePath": {
          "default": "v1",
          "description": "Version number"
        }
      }
    }
  ],
  "paths": {
    "/{tenant}/general-roster/roster-data": {
      "get": {
        "tags": [
          "Roster"
        ],
        "summary": "Return the duties that have been rostered and assigned to a person",
        "description": "Retrieve roster data for employees within the Optima system. Returns comprehensive roster information, including employee details, organizational structure, shift information, and timing data. At least one of personID or unitID must be provided. You can query either:\r\n\r\n- By individual employee (personID) - gets one person's shifts\r\n- By organizational unit (unitID) - gets shifts for everyone in that department/unit\r\n\r\n**Usage Examples**:\r\n\r\n**Get roster for a specific person** (14-day default range):\r\n```\r\nGET /{tenant}/api/general-roster/roster-data?personID=1625\r\n```\r\n**Get roster for a person with custom date range**:\r\n```\r\nGET /{tenant}/api/general-roster/roster-data?personID=1625&from=2024-01-01&to=2024-01-14\r\n```\r\n**Get roster for an organizational unit** (2-day default range):\r\n```\r\nGET /{tenant}/api/general-roster/roster-data?unitID=1059\r\n```\r\n**Get roster for an organizational unit with custom date range**:\r\n```\r\nGET /{tenant}/api/general-roster/roster-data?unitID=1059&from=2024-01-01&to=2024-01-02\r\n```",
        "parameters": [
          {
            "name": "tenant",
            "in": "path",
            "description": "Tenant code",
            "required": true,
            "schema": {
              "type": "string",
              "example": "SAFEHEALTHLIVE"
            }
          },
          {
            "name": "personID",
            "in": "query",
            "description": "Person ID to filter roster data.",
            "schema": {
              "type": "integer",
              "example": 1625
            }
          },
          {
            "name": "unitID",
            "in": "query",
            "description": "Unit ID to filter roster data.",
            "schema": {
              "type": "integer",
              "example": 1059
            }
          },
          {
            "name": "from",
            "in": "query",
            "description": "Optional start date for roster data. Defaults to today if not provided.",
            "schema": {
              "type": "string",
              "format": "date-time",
              "example": "2024-01-01"
            }
          },
          {
            "name": "to",
            "in": "query",
            "description": "Optional end date for roster data. If not provided, a default end date will be used.",
            "schema": {
              "type": "string",
              "format": "date-time",
              "example": "2024-01-02"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "200 response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RosterDataResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Invalid input parameters or missing required combination. Possible error scenarios:\n- Neither personID nor unitID provided\n- Both personID and unitID provided simultaneously\n- Invalid date range (to date is before from date)\n- Date range exceeds maximum allowed days (2 days for unit queries, 14 days for person queries)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "description": "Error message describing the validation failure",
                      "example": "Only one of personID or unitID can be provided, not both"
                    }
                  }
                },
                "examples": {
                  "MissingBothParameters": {
                    "summary": "Neither personID nor unitID provided",
                    "description": "At least one of personID or unitID must be specified",
                    "value": {
                      "message": "At least one of personID or unitID must be provided"
                    }
                  },
                  "BothParametersProvided": {
                    "summary": "Both personID and unitID provided",
                    "description": "Only one parameter can be specified, not both",
                    "value": {
                      "message": "Only one of personID or unitID can be provided, not both"
                    }
                  },
                  "ToDateBeforeFromDate": {
                    "summary": "Invalid date range - to date before from date",
                    "description": "The 'to' date must be greater than or equal to the 'from' date",
                    "value": {
                      "message": "'to' date (2024-01-01) must be greater than or equal to 'from' date (2024-01-15)."
                    }
                  },
                  "DateRangeExceedsMaximum": {
                    "summary": "Date range exceeds maximum allowed days",
                    "description": "For Unit queries, the date range cannot exceed 2 days",
                    "value": {
                      "message": "Date range for Unit queries cannot exceed 2 days. Requested range is 5 days."
                    }
                  },
                  "PersonDateRangeExceedsMaximum": {
                    "summary": "Person query date range exceeds maximum allowed days",
                    "description": "For Person queries, the date range cannot exceed 14 days",
                    "value": {
                      "message": "Date range for Person queries cannot exceed 14 days. Requested range is 20 days."
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "custom-auth": [ ]
          }
        ],
        "x-amazon-apigateway-request-validator": "Marketplace-${env}-Validate query parameters",
        "x-amazon-apigateway-integration": {
          "httpMethod": "GET",
          "uri": "https://${eac_api_base_url}/{tenant}/api/GeneralRoster/RosterData",
          "responses": {
            "default": {
              "statusCode": "200"
            }
          },
          "passthroughBehavior": "when_no_match",
          "timeoutInMillis": 29000,
          "type": "http",
          "requestParameters": {
            "integration.request.header.Cookie": "context.authorizer.session_cookie",
            "integration.request.path.tenant": "method.request.path.tenant",
            "integration.request.querystring.personID": "method.request.querystring.personID",
            "integration.request.querystring.unitID": "method.request.querystring.unitID",
            "integration.request.querystring.from": "method.request.querystring.from",
            "integration.request.querystring.to": "method.request.querystring.to"
          }
        }
      }
    },
