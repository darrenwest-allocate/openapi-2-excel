  "components": {
    "schemas": {
      "RosterDataResponse": {
        "type": "object",
        "properties": {
          "rosterData": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "PersonID": {
                  "type": "integer",
                  "description": "Unique identifier for the Person",
                  "example": 16001
                },
                "Surname": {
                  "type": "string",
                  "description": "Last name of the employee",
                  "example": "O'Neal"
                },
                "Forenames": {
                  "type": "string",
                  "description": "First name(s) of the employee",
                  "example": "Alice"
                },
                "StaffNumber": {
                  "type": "string",
                  "description": "Staff identification number",
                  "example": "AO63889661856127"
                },
                "TimeclockIdentifier": {
                  "type": "string",
                  "description": "Timeclock chip ID for attendance tracking",
                  "example": "AO63889661856127"
                },
                "DateJoined": {
                  "type": "string",
                  "description": "Date when the Person was first employed at the organisation",
                  "format": "date-time",
                  "example": "2025-07-27T00:00:00"
                },
