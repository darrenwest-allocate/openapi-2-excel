            }
          },
          {
            "name": "gradeTypeCategoryID",
            "in": "query",
            "description": "Filter for those records for a Grade Type Category by using its unique key.",
            "schema": {
              "type": "string",
              "example": "1002"
            }
          },
          {
            "name": "staffGroupID",
            "in": "query",
            "description": "Filter for those records for a Staff Group by using its unique key.",
            "schema": {
              "type": "string",
              "example": "1003"
            }
          },
          {
            "name": "validFrom",
            "in": "query",
            "description": "Only return records valid on or after this date.",
            "schema": {
              "type": "string",
              "format": "date-time",
              "example": "1900-01-01"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GradeResponseModel"
                }
              }
            }
          }
        },
        "security": [
          {
            "custom-auth": [ ]
          }
        ],
        "x-amazon-apigateway-request-validator": "Marketplace-${env}-Validate query parameters",
        "x-amazon-apigateway-integration": {
          "httpMethod": "GET",
          "uri": "https://${eac_api_base_url}/{tenant}/api/ReferenceData/Grades",
          "responses": {
            "default": {
              "statusCode": "200"
            }
          },
          "passthroughBehavior": "when_no_match",
          "timeoutInMillis": 29000,
          "type": "http",
          "requestParameters": {
            "integration.request.header.Cookie": "context.authorizer.session_cookie",
            "integration.request.path.tenant": "method.request.path.tenant",
            "integration.request.querystring.ID": "method.request.querystring.ID",
            "integration.request.querystring.shortName": "method.request.querystring.shortName",
            "integration.request.querystring.gradeTypeID": "method.request.querystring.gradeTypeID",
            "integration.request.querystring.gradeTypeCategoryID": "method.request.querystring.gradeTypeCategoryID",
            "integration.request.querystring.staffGroupID": "method.request.querystring.staffGroupID",
            "integration.request.querystring.validFrom": "method.request.querystring.validFrom"
          }
        }
      }
    },
