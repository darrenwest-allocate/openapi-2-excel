                "validFrom": {
                  "type": "string",
                  "description": "Start date for the cost centre's validity",
                  "example": "1900-01-01T00:00:00"
                },
                "validTo": {
                  "type": "string",
                  "description": "End date for the cost centre's validity",
                  "example": "9999-12-31T00:00:00"
                },
                "code": {
                  "type": "string",
