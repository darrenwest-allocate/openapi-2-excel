  "paths": {
    "/{tenant}/duties/roster-data": {
      "get": {
        "tags": [
          "Roster"
        ],
        "summary": "Get Roster Data",
        "description": "Retrieve roster data for employees within Optima system. Returns comprehensive roster information including employee details, organizational structure, shift information, and timing data. At least one of PersonId or UnitId must be provided. Date range is optional - if not provided, defaults to 4 weeks from current date.\n\n**Usage Examples:**\n- `GET /{tenant}/duties/roster-data?personId=12345`\n- `GET /{tenant}/duties/roster-data?unitId=67890&from=2024-01-01&to=2024-01-31`\n- `GET /{tenant}/duties/roster-data?personId=12345&from=2024-01-01&to=2024-01-31`",
        "parameters": [
          {
            "name": "tenant",
            "in": "path",
            "description": "Tenant code",
            "required": true,
            "schema": {
              "type": "string",
              "example": "example-tenant"
            }
          },
          {
            "name": "personId",
            "in": "query",
            "description": "Person Id to filter roster data (optional - at least one of personId or unitId must be provided)",
            "schema": {
              "type": "integer",
              "example": 12345
            }
          },
          {
            "name": "unitId",
            "in": "query",
            "description": "Unit Id to filter roster data (optional - at least one of personId or unitId must be provided)",
            "schema": {
              "type": "integer",
              "example": 67890
            }
          },
          {
            "name": "from",
            "in": "query",
            "description": "Start date for roster data in YYYY-MM-DD format (optional - defaults to 4 weeks from current date)",
            "schema": {
              "type": "string",
              "example": "2024-01-01"
            }
          },
          {
            "name": "to",
            "in": "query",
            "description": "End date for roster data in YYYY-MM-DD format (optional - defaults to 4 weeks from current date)",
            "schema": {
              "type": "string",
              "example": "2024-01-31"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "200 response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RosterDataResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Invalid input parameters or missing required combination",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "description": "Error message",
                      "example": "At least one of personId or unitId must be provided"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "custom-auth": [ ]
          }
        ],
        "x-amazon-apigateway-request-validator": "Interop-${env}-Validate query parameters",
        "x-amazon-apigateway-integration": {
          "httpMethod": "GET",
          "uri": "https://${eac_api_base_url}/v1/api/Roster/Data",
          "responses": {
            "default": {
              "statusCode": "200"
            }
          },
          "passthroughBehavior": "when_no_match",
          "timeoutInMillis": 29000,
          "type": "http_proxy",
          "requestParameters": {
            "integration.request.header.Cookie": "context.authorizer.session_cookie",
            "integration.request.path.tenant": "method.request.path.tenant",
            "integration.request.querystring.personId": "method.request.querystring.personId",
            "integration.request.querystring.unitId": "method.request.querystring.unitId",
            "integration.request.querystring.from": "method.request.querystring.from",
            "integration.request.querystring.to": "method.request.querystring.to"
          }
        }
      }
    },
